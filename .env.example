# --- Watchlist -------------------------------------------------------------
# Comma-separated names to match against Senate/House Stock Watcher disclosure
# data (case-insensitive substring match against the "senator"/"representative"
# field). There is no real-time, transaction-level disclosure feed for the
# President or Vice President — OGE Form 278 is an annual, range-based filing,
# not a 45-day trade-by-trade STOCK Act report like Congress files. Populate
# this with the members of Congress you actually want to track; see README
# "What this can and can't see" before assuming it covers the executive branch.
WATCHLIST=

# --- Market data -------------------------------------------------------------
# yfinance needs no API key. Leave blank unless you're swapping in a paid
# vendor (Alpha Vantage, Polygon, etc.) via tracker/data/prices.py.
PRICE_DATA_PROVIDER=yfinance

# --- News / policy events ----------------------------------------------------
# GDELT's DOC 2.0 API is free and requires no key (default). Set a NewsAPI.org
# key here only if you swap the provider in tracker/data/news.py.
NEWSAPI_KEY=

# --- Insider tracking (wealthy/notable individuals) -------------------------
# Matched against SEC Form 4 filings (see tracker/data/insider_trades.py) —
# only covers trades in companies where the person is an officer/director/
# 10%+ owner (e.g. Musk <-> Tesla, Bezos <-> Amazon), not their full personal
# portfolio, and not private companies (SpaceX, Blue Origin).
WATCHED_INSIDERS=Elon Musk,Jeff Bezos
# Required by SEC's fair-access policy: identify yourself in the User-Agent
# sent to data.sec.gov / www.sec.gov. Put a real contact email here.
SEC_EDGAR_CONTACT=you@example.com

# --- Backtest ------------------------------------------------------------
# Base currency is GBP — converted to USD at run time via tracker/data/fx.py
# since the underlying instruments trade in USD.
INITIAL_CAPITAL_GBP=500
FX_FALLBACK_GBPUSD=1.27
MAX_POSITION_PCT=0.10
TRANSACTION_COST_BPS=5

# Informational only — wire the actual schedule via a cron trigger that
# invokes `python -m tracker.cli daily-run` (see README "Daily automation").
DAILY_RUN_TIME_UK=07:00

# --- Alpaca paper trading (execution/paper_broker.py) ------------------------
# PAPER KEYS ONLY. ALPACA_BASE_URL must stay pointed at paper-api.alpaca.markets
# — paper_broker.py refuses to run against any other host, including Alpaca's
# live-trading endpoint. There is no code path in this repo that places a live
# order with real money.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
